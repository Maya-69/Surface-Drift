# The directory containing asm.py, modules/, resources/, and keylist.asm
ASM_PROJECT_ROOT=..

# Web download and scan output paths (defaults are safe local directories)
# ASM_ARTIFACTS_DIR=./asm-web-ui/artifacts
# ASM_RUNS_DIR=./demo_run

# Maximum wall time per scan, in seconds
ASM_SCAN_TIMEOUT_SECONDS=900
HOST=127.0.0.1
PORT=8000
